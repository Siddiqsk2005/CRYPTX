generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Role { VICTIM INVESTIGATOR ADMIN }
enum CaseStatus { NEW UNDER_ANALYSIS VASP_IDENTIFIED FREEZE_RECOMMENDED EVIDENCE_PRESERVED CLOSED }
enum RiskLevel { LOW MEDIUM HIGH CRITICAL }
enum AttributionType { CONFIRMED_ATTRIBUTION PROBABLE_ATTRIBUTION ANALYTICAL_CLUSTER UNKNOWN }

model User { id String @id @default(cuid()) email String @unique passwordHash String name String role Role @default(VICTIM) complaints Complaint[] investigatorCases Investigation[] auditLogs AuditLog[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Complaint { id String @id @default(cuid()) caseId String @unique fraudType String description String blockchain String amount Decimal? @db.Decimal(20,8) currency String? transactionHash String? suspectWallet String victimId String victim User @relation(fields:[victimId],references:[id]) investigation Investigation? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([caseId]) @@index([suspectWallet]) @@index([blockchain]) }
model Investigation { id String @id @default(cuid()) complaintId String @unique complaint Complaint @relation(fields:[complaintId],references:[id]) investigatorId String? investigator User? @relation(fields:[investigatorId],references:[id]) status CaseStatus @default(NEW) dataMode String @default("DEMO") riskAssessment RiskAssessment? notes InvestigationNote[] reports InvestigationReport[] alerts Alert[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Wallet { id String @id @default(cuid()) address String blockchain String label String? type String @default("UNKNOWN") riskLevel RiskLevel? transactionsFrom Transaction[] @relation("FromWallet") transactionsTo Transaction[] @relation("ToWallet") @@unique([address,blockchain]) @@index([address]) }
model Transaction { id String @id @default(cuid()) transactionHash String blockchain String fromWalletId String toWalletId String amount Decimal @db.Decimal(30,12) token String timestamp DateTime hop Int @default(0) synthetic Boolean @default(false) fromWallet Wallet @relation("FromWallet",fields:[fromWalletId],references:[id]) toWallet Wallet @relation("ToWallet",fields:[toWalletId],references:[id]) @@index([transactionHash]) @@index([timestamp]) }
model VASP { id String @id @default(cuid()) name String type String country String? website String? riskLevel RiskLevel? attributionSource String verified Boolean @default(false) confidence Int @default(0) wallets VASPWallet[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model VASPWallet { id String @id @default(cuid()) vaspId String vasp VASP @relation(fields:[vaspId],references:[id]) blockchain String walletAddress String label String walletType String confidence Int source String verified Boolean @default(false) @@unique([blockchain,walletAddress]) @@index([walletAddress]) }
model RiskAssessment { id String @id @default(cuid()) investigationId String @unique investigation Investigation @relation(fields:[investigationId],references:[id]) score Int riskLevel RiskLevel signals RiskSignal[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model RiskSignal { id String @id @default(cuid()) assessmentId String assessment RiskAssessment @relation(fields:[assessmentId],references:[id]) name String score Int evidence String severity RiskLevel }
model InvestigationNote { id String @id @default(cuid()) investigationId String investigation Investigation @relation(fields:[investigationId],references:[id]) authorId String content String createdAt DateTime @default(now()) }
model InvestigationReport { id String @id @default(cuid()) investigationId String investigation Investigation @relation(fields:[investigationId],references:[id]) reportId String @unique type String storagePath String? createdAt DateTime @default(now()) }
model Alert { id String @id @default(cuid()) investigationId String investigation Investigation @relation(fields:[investigationId],references:[id]) pattern String severity RiskLevel evidence String relatedTransactions String[] createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) userId String? user User? @relation(fields:[userId],references:[id]) action String caseId String? role Role? result String timestamp DateTime @default(now()) @@index([caseId]) @@index([timestamp]) }
